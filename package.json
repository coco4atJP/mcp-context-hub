{
  "name": "@nekon/mcp-context-hub",
  "version": "0.4.0",
  "private": true,
  "description": "A lazy MCP gateway with a small, fixed context footprint",
  "type": "module",
  "bin": {
    "mcp-context-hub": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples",
    "skills"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc && vite build",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "tsc --noEmit && tsc -p ui/tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ipaddr.js": "^2.5.0",
    "undici": "^7.29.1",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/coco4atJP/mcp-context-hub.git"
  }
}
